{
  "manifest_version": 3,
  "name": "ScreenerKit",
  "version": "0.6.0",
  "description": "Compact and customize the TradingView Screener.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.tradingview.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ScreenerKit",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": [
        "src/core/namespace.js",
        "src/core/settings.js",
        "src/core/style-manager.js",
        "src/core/screener-table-adapter.js",
        "src/features/interface-theme.js",
        "src/features/screener-symbol-width.js",
        "src/features/screener-table-density.js",
        "src/features/screener-grid-lines.js",
        "src/features/screener-multi-sort.js",
        "src/core/lifecycle.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
